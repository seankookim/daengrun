#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# pre-push — migration-number collision guard
#
# Why this exists: on 2026-08-13 this repo had SIX migration-number collisions.
# Five were sessions racing. The sixth happened with nobody being careless — the
# stated rule was "a number is claimed when it is on origin", someone read the
# REGISTRY row on origin (which said the number was free), and was still wrong,
# because the FILE was on origin while its ROW was not. The rule described half
# the state.
#
# A protocol that fails when everyone obeys it is a protocol problem, so this
# check replaces the discipline:
#
#   ① a number introduced here must not exist on ANY other remote branch
#   ② a number introduced here must ship WITH its REGISTRY.md row
#   ④ a row this push marks DEPLOYED must ship WITH its migration FILE
#
# ④ is ② turned around, and it was added on 2026-08-15 after the third member of
# the family showed up: trunk's top migration file was 0097 while production had
# 0098 and 0099 applied, because their REGISTRY rows were merged to trunk and
# their FILES were only ever on a feature branch. The ledger said DEPLOYED, the
# database agreed, and the source of the live schema was not on the trunk anyone
# cuts from — so every harness run on trunk tested a schema that no longer
# existed, and deleting that branch would have left production unreproducible.
#
# Scoped to rows this push INTRODUCES, exactly like ① and ②. A pre-existing gap
# must not refuse the pushes of people who did not cause it — collective refusal
# teaches everyone to reach for --no-verify, which costs more than the bug.
#
# Both checks apply only to migrations this push actually INTRODUCES, so history
# and merges of the trunk are unaffected.
#
# Escape hatch (rarely the right answer):  git push --no-verify
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

remote="${1:-origin}"
MIGDIR="supabase/migrations"
ZERO=0000000000000000000000000000000000000000

note() { printf '%s\n' "$*" >&2; }

# Repos/branches without a migrations dir have nothing to guard.
git rev-parse --verify --quiet HEAD >/dev/null 2>&1 || exit 0

# Refresh remote refs, so a file another session pushed a minute ago is visible.
# Never fatal: a network hiccup must not block a push.
git fetch --quiet "$remote" 2>/dev/null || true

# Every migration FILE already present on any remote branch: "NNNN<TAB>name<TAB>branch"
claimed=$(
  for ref in $(git for-each-ref --format='%(refname)' "refs/remotes/$remote/" 2>/dev/null); do
    br=${ref#"refs/remotes/$remote/"}
    [ "$br" = "HEAD" ] && continue
    git ls-tree --name-only "$ref" "$MIGDIR/" 2>/dev/null |
      sed -n "s|^$MIGDIR/\([0-9]\{4\}\)_\(.*\)\.sql\$|\1	\2	$br|p"
  done
)

# Every migration ROW already present in any remote branch's REGISTRY: "NNNN<TAB>name<TAB>branch"
#
# This is the half the file check structurally cannot see. On 2026-08-13 origin carried TWO
# `0089` rows and ZERO `0089` files for a stretch — two sessions had claimed the number and
# neither had pushed a migration, so nothing compared against files could refuse either push.
# A claim is the moment a collision is free to fix; a file is the moment it is not.
rowed=$(
  for ref in $(git for-each-ref --format='%(refname)' "refs/remotes/$remote/" 2>/dev/null); do
    br=${ref#"refs/remotes/$remote/"}
    [ "$br" = "HEAD" ] && continue
    git show "$ref:$MIGDIR/REGISTRY.md" 2>/dev/null |
      awk -F'|' -v B="$br" '/^\|/ {
        n=$2; f=$3; gsub(/[ `]/,"",n); gsub(/[ `]/,"",f)
        if (n ~ /^[0-9][0-9][0-9][0-9]$/ && f ~ /\.sql$/) print n "\t" f "\t" B
      }'
  done
)

fail=0

while read -r _local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion
  pushed_br=${remote_ref#refs/heads/}

  registry=$(git show "$local_sha:$MIGDIR/REGISTRY.md" 2>/dev/null || true)

  # ③ ROW-level collision — runs BEFORE the file gate, because a claim-only push has no file.
  if [ -n "$registry" ]; then
    myrows=$(printf '%s\n' "$registry" |
      awk -F'|' '/^\|/ {
        n=$2; f=$3; gsub(/[ `]/,"",n); gsub(/[ `]/,"",f)
        if (n ~ /^[0-9][0-9][0-9][0-9]$/ && f ~ /\.sql$/) print n "\t" f
      }')
    while IFS=$'\t' read -r rnum rfile; do
      [ -z "${rnum:-}" ] && continue
      rhit=$(printf '%s\n' "$rowed" |
               awk -F'\t' -v n="$rnum" -v f="$rfile" -v b="$pushed_br" \
                   '$1==n && $2!=f && $3!=b {print "     " $2 "  claimed on " $3}' | sort -u)
      if [ -n "$rhit" ]; then
        note "❌ REGISTRY row for $rnum collides with a claim on another branch:"
        printf '%s\n' "$rhit" >&2
        note "     yours: $rfile"
        note "   Two rows for one number is the state the file check cannot see."
        note "   Settle it at the claim — whoever has not written the file moves."
        fail=1
      fi
    done <<EOF
$myrows
EOF
  fi

  # ④ a row this push newly marks DEPLOYED must carry its migration FILE.
  #
  # The inverse of ②. ② stops a file arriving without its claim; ④ stops a claim
  # announcing a DEPLOYED migration whose source never reaches this branch. Both
  # halves of "is this migration real?" are now mechanical.
  if [ -n "$registry" ]; then
    # Rows already marked DEPLOYED on the remote side of this same branch are not
    # introduced by this push — pre-existing state is somebody else's problem to
    # fix, not this push's to be blamed for.
    # Compare against the sha git says the REMOTE is at for this push, not against
    # the remote-tracking ref. They differ, and the difference is the whole check:
    # the ref is "wherever origin is now", while remote_sha is "what this push is
    # actually advancing past". Reading the ref made the check skip a row that the
    # push itself introduced whenever the row had since landed by another route —
    # measured, by replaying the real 0098 push and watching it stay silent.
    prev_src=$remote_sha
    [ "$prev_src" = "$ZERO" ] && prev_src=""
    prev_dep=$([ -n "$prev_src" ] && git show "$prev_src:$MIGDIR/REGISTRY.md" 2>/dev/null |
      awk -F'|' '/^\|/ && /DEPLOYED/ { n=$2; gsub(/[ `]/,"",n); if (n ~ /^[0-9][0-9][0-9][0-9]$/) print n }')
    new_dep=$(printf '%s\n' "$registry" |
      awk -F'|' '/^\|/ && /DEPLOYED/ { n=$2; gsub(/[ `]/,"",n); if (n ~ /^[0-9][0-9][0-9][0-9]$/) print n }')
    while read -r dnum; do
      [ -z "${dnum:-}" ] && continue
      printf '%s\n' "$prev_dep" | grep -qx "$dnum" && continue      # already DEPLOYED upstream
      if ! git ls-tree --name-only "$local_sha" "$MIGDIR/" 2>/dev/null |
             grep -Eq "^$MIGDIR/${dnum}_.*\.sql$"; then
        note "❌ REGISTRY marks $dnum DEPLOYED, but no ${dnum}_*.sql is in this push."
        note "   A deployed migration whose file is not on this branch means the live"
        note "   schema has no source here: the harness would test a database that no"
        note "   longer exists, and losing the branch would lose the only copy."
        note "   Merge the branch carrying ${dnum}_*.sql, or push the file with the row."
        fail=1
      fi
    done <<EOF
$new_dep
EOF
  fi

  mine=$(git ls-tree --name-only "$local_sha" "$MIGDIR/" 2>/dev/null |
           sed -n "s|^$MIGDIR/\([0-9]\{4\}\)_\(.*\)\.sql\$|\1	\2|p")
  [ -z "$mine" ] && continue

  while IFS=$'\t' read -r num name; do
    [ -z "${num:-}" ] && continue

    # Is this file already on a remote branch under the SAME name? Then this push
    # does not introduce it (it's history, or a trunk merge) — skip both checks.
    if printf '%s\n' "$claimed" |
         awk -F'\t' -v n="$num" -v f="$name" '$1==n && $2==f {found=1} END{exit !found}'; then
      continue
    fi

    # ① same NUMBER, different FILENAME, on some other remote branch = collision
    hit=$(printf '%s\n' "$claimed" |
            awk -F'\t' -v n="$num" -v f="$name" -v b="$pushed_br" \
                '$1==n && $2!=f && $3!=b {print "     " $1 "_" $2 ".sql  on " $3}' | sort -u)
    if [ -n "$hit" ]; then
      note "❌ migration $num is already claimed on another branch:"
      printf '%s\n' "$hit" >&2
      note "     yours: ${num}_${name}.sql"
      note "   A number is taken when EITHER its row or its file reaches origin."
      fail=1
    fi

    # ② the REGISTRY row must travel with the file, not an hour behind it
    if [ -n "$registry" ] && ! printf '%s\n' "$registry" | grep -Eq "^\| *$num *\|"; then
      note "❌ migration $num has no REGISTRY.md row in this push."
      note "   Push the migration and its claim row in the same breath — a row"
      note "   trailing its file is exactly the window collision six walked through."
      fail=1
    fi
  done <<EOF
$mine
EOF
done

if [ "$fail" -ne 0 ]; then
  note ""
  note "Push refused. Claim numbers in $MIGDIR/REGISTRY.md on origin BEFORE writing the file."
  note "Override only if you know why:  git push --no-verify"
  exit 1
fi

exit 0
