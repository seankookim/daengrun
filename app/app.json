{
  "expo": {
    "name": "도그스하이",
    "slug": "daengrun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "nmap"
        ],
        "NSLocationWhenInUseUsageDescription": "러닝 거리 측정과 보호자 실시간 지도를 위해 위치를 사용해요.",
        "NSCameraUsageDescription": "러닝 중 반려견의 순간을 촬영해 보호자에게 보내기 위해 카메라를 사용해요.",
        "NSSupportsLiveActivities": true
      },
      "bundleIdentifier": "com.seankookim.daengrun"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "daengrun",
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "@mj-studio/react-native-naver-map",
        {
          "client_id": "3vpkxtglpe"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://repository.map.naver.com/archive/maven"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필과 러닝 사진을 위해 사진 보관함에 접근해요.",
          "cameraPermission": "러닝 중 반려견의 순간을 촬영해 보호자에게 보내기 위해 카메라를 사용해요."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "러닝 거리 측정과 보호자 실시간 지도를 위해 위치를 사용해요."
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": []
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.seankookim.daengrun.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.seankookim.daengrun"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "0436bc27-2933-4627-a0bf-9527e65c1ad9"
      }
    },
    "owner": "seankookim"
  }
}
